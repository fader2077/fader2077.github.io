---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/publications/PublicationItem.astro';
import { getCollection } from 'astro:content';
import { getPublicationStats } from '../lib/publication-stats';
import { sortPublications } from '../lib/sort-content';
const entries = await getCollection('publications');
const publications = sortPublications(entries.map((entry) => ({ ...entry.data, entry }))).map(({ entry }) => entry);
const stats = getPublicationStats(publications.map(({ data }) => data));
const articleSchemas = publications.filter(({ data }) => data.verified).map(({ data }) => ({
  '@type': 'ScholarlyArticle',
  headline: data.title,
  author: data.authors.map((name) => ({ '@type': 'Person', name })),
  datePublished: String(data.year),
  isPartOf: { '@type': 'Periodical', name: data.venue },
  ...(data.doi ? { identifier: `https://doi.org/${data.doi}` } : {}),
  ...(data.url ? { sameAs: data.url } : {}),
}));
---
<BaseLayout title="Publications | Jie-Xin Li" description="Verified academic publications and research outputs." canonicalPath="/publications.html" structuredData={articleSchemas}>
  <header class="page-intro"><p class="eyebrow">Research record</p><h1>Publications</h1><p><strong>{stats.formalResults}</strong> independently verified formal results. Other migrated records remain visibly marked for metadata verification.</p></header>
  <form class="filter-bar" data-publication-filters>
    <label>Publication type<select name="type"><option value="all">All types</option><option value="journal">Journal</option><option value="conference">Conference</option><option value="workshop">Workshop</option><option value="poster">Poster</option></select></label>
    <label>Status<select name="status"><option value="all">All statuses</option><option value="published">Published</option><option value="accepted">Accepted</option><option value="in_press">In press</option><option value="under_revision">Under revision</option><option value="under_review">Under review</option><option value="submitted">Submitted</option></select></label>
    <button type="reset">Reset filters</button>
    <output aria-live="polite" data-filter-count>{publications.length} records</output>
  </form>
  <section class="publication-list">{publications.map((publication) => <PublicationItem publication={publication} />)}</section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-publication-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-publication]')];
  const output = form?.querySelector<HTMLOutputElement>('[data-filter-count]');
  const applyFilters = () => {
    if (!form) return;
    const data = new FormData(form);
    const type = String(data.get('type'));
    const status = String(data.get('status'));
    let visible = 0;
    for (const item of items) {
      item.hidden = !((type === 'all' || item.dataset.type === type) && (status === 'all' || item.dataset.status === status));
      if (!item.hidden) visible += 1;
    }
    if (output) output.value = `${visible} records`;
  };
  form?.addEventListener('change', applyFilters);
  form?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
</script>
