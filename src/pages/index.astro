---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sectionRegistry } from '../lib/section-registry';
import { getEnabledSections, type SectionType, type SiteSection } from '../lib/section-types';
import { loadDataFile } from '../lib/site-data';
const { sections: configuredSections } = await loadDataFile<{ sections: SiteSection[] }>('site-sections');
const sections = getEnabledSections(configuredSections);
---
<BaseLayout title="Jie-Xin Li | Applied AI Systems" description="Portfolio focused on applied AI, trustworthy LLM systems, and deployable research." canonicalPath="/">
  {sections.map((section) => {
    const Component = sectionRegistry[section.type as SectionType];
    return <Component section={section} />;
  })}
</BaseLayout>
